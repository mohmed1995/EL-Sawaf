@echo off
chcp 65001 > nul
title منظومة الصواف للأقمشة - الخادم المحلي
echo ======================================================
echo    منظومة الصواف للأقمشة والمنسوجات - صعيد مصر
echo    جاري تشغيل واجهة البيع الفاخرة وإدارة الأتواب...
echo ======================================================

:: فحص ما إذا كان المتصفح إيدج أو كروم متاحاً للتشغيل كبرنامج مستقل (App Mode)
set URL=http://localhost:5173/

:: تشغيل متصفح Edge في وضع التطبيق المستقل (بدون شريط عناوين)
start msedge --app=%URL% || start chrome --app=%URL% || start "" "%URL%"

echo.
echo النظام يعمل الآن على الرابط: %URL%
echo لإيقاف النظام اضغط Ctrl+C
pause
